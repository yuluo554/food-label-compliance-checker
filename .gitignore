# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
# 构建产物（`pip install -e .` / `python -m build` 会在仓内生成）
build/
dist/

# 环境与密钥
.env
*.key
*_private/

# 运行产物
output/
reports/
*.log

# 二次迭代交接物（诊断/路线/提示词/执行记录）：含本机绝对路径，不入公共仓
update/

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 生成器批量产物不入仓；仅冻结 fixtures 小集入仓（fixtures 策略见 plan/05 §1.1/§1.3）
data/generated/*
!data/generated/frozen/
